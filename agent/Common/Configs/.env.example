INTERVIEW_GUIDE_OPENAI_BASE_URL=https://api.openai.com/v1
INTERVIEW_GUIDE_OPENAI_MODEL=gpt-4.1-mini
INTERVIEW_GUIDE_OPENAI_API_KEY=replace-me
# 向量模型服务配置；RAG 入库和检索时使用，未配置时不应伪装成已启用。
INTERVIEW_GUIDE_EMBEDDING_BASE_URL=https://api.openai.com/v1
INTERVIEW_GUIDE_EMBEDDING_MODEL=text-embedding-3-small
INTERVIEW_GUIDE_EMBEDDING_API_KEY=replace-me
INTERVIEW_GUIDE_EMBEDDING_DIMENSIONS=1536
# PostgreSQL 数据库密码（需要与 INTERVIEW_GUIDE_POSTGRES_URL 中的密码一致）
POSTGRES_PASSWORD=replace-me
# PostgreSQL 连接地址（必需，格式：postgresql://用户名:密码@主机:端口/数据库名）
INTERVIEW_GUIDE_POSTGRES_URL=postgresql://interview_agent:replace-me@postgres:5432/interview_agent
# Redis 连接地址（必需）
INTERVIEW_GUIDE_REDIS_URL=redis://redis:6379/0
# RabbitMQ 连接地址（必需）
INTERVIEW_GUIDE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
